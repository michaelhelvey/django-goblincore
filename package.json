{
  "name": "goblincore",
  "version": "1.0.0",
  "private": true,
  "description": "Opinionated starter project for modern fullstack applications with Django",
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "dev": "uv run ./manage.py runserver",
    "format": "pnpm run /^format:.*/",
    "format:py": "uv run ruff format . && uv run ruff check --select I --fix .",
    "format:js": "vp fmt",
    "lint": "pnpm run /^lint:.*/",
    "lint:js": "vp lint --fix",
    "lint:py": "uv run ruff check .",
    "test": "pnpm run /^test:.*/",
    "test:py": "pytest -v --cov --cov-report=term-missing",
    "test:js": "vp test",
    "build": "vp build",
    "local-setup": "./scripts/setup.sh",
    "validate": "pnpm format && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {},
  "devDependencies": {
    "@michaelhelvey/vite-config": "^1.0.2",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^25.6.0",
    "daisyui": "^5.5.19",
    "happy-dom": "^20.9.0",
    "lucide": "1.14.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-plus": "^0.1.20"
  },
  "packageManager": "pnpm@11.0.8+sha512.4c4097e1dd2d42372c4e7fa5a791ff28fc75a484c7ac192e64b1df0fdef17594ba982f9b4fed9adfb3c757846f565b799b2763fb3733d1de1bcb82cf46684912"
}
