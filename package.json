{
  "name": "goblincore",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Opinionated starter project for modern fullstack applications with Django",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "prepare": "lefthook install",
    "format": "prettier --write --ignore-unknown .",
    "lint": "eslint ./app/static/js/**/*",
    "test": "vitest"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.1",
    "@eslint/core": "^1.0.1",
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "^4.1.18",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^25.0.10",
    "daisyui": "^5.5.14",
    "eslint": "^9.39.2",
    "lefthook": "^2.0.15",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "prettier": {
    "proseWrap": "always",
    "singleQuote": false,
    "semi": true,
    "trailingComma": "all",
    "useTabs": false,
    "printWidth": 100,
    "tabWidth": 2,
    "plugins": [
      "@trivago/prettier-plugin-sort-imports",
      "prettier-plugin-tailwindcss"
    ],
    "importOrder": [
      "^node:.*$",
      "<THIRD_PARTY_MODULES>",
      "^[./]"
    ],
    "importOrderSeparation": false,
    "importOrderSortSpecifiers": true
  },
  "dependencies": {
    "lucide": "0.562.0"
  }
}
